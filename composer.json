{
	"name": "qbitflow/qbitflow-php",
	"description": "Official PHP SDK for QBitFlow - Next Generation Crypto Payment Processing",
	"type": "library",
	"keywords": [
		"qbitflow",
		"cryptocurrency",
		"crypto",
		"payment",
		"payment-processing",
		"solana",
		"ethereum",
		"blockchain",
		"subscription",
		"recurring-billing",
		"payment-gateway",
		"api-client",
		"laravel",
		"php",
		"sdk"
	],
	"homepage": "https://qbitflow.app",
	"license": "MPL-2.0",
	"authors": [
		{
			"name": "QBitFlow",
			"email": "support@qbitflow.app",
			"homepage": "https://qbitflow.app"
		}
	],
	"support": {
		"issues": "https://github.com/QBitFlow/qbitflow-php-sdk/issues",
		"source": "https://github.com/QBitFlow/qbitflow-php-sdk",
		"docs": "https://qbitflow.app/docs"
	},
	"require": {
		"php": "~8.2.35 || ~8.3.36 || ~8.4.27 || >=8.5.12",
		"ext-json": "*",
		"guzzlehttp/guzzle": "^7.15.2 || ^8.0.1",
		"psr/http-client": "^1.0",
		"psr/http-factory": "^1.0",
		"psr/http-message": "^1.1 || ^2.0",
		"psr/http-server-handler": "^1.0"
	},
	"require-dev": {
		"illuminate/config": "^10.0 || ^11.0 || ^12.0 || ^13.0",
		"illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
		"illuminate/events": "^10.0 || ^11.0 || ^12.0 || ^13.0",
		"illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
		"illuminate/routing": "^10.0 || ^11.0 || ^12.0 || ^13.0",
		"illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
		"nyholm/psr7": "^1.8",
		"php-http/discovery": "^1.19",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^10.5 || ^11.0",
		"vlucas/phpdotenv": "^5.6"
	},
	"conflict": {
		"illuminate/support": "<10.0"
	},
	"suggest": {
		"illuminate/support": "Enables the Laravel service provider, facade, Artisan commands and webhook middleware."
	},
	"autoload": {
		"psr-4": {
			"QBitFlow\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"QBitFlow\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"QBitFlow\\Laravel\\QBitFlowServiceProvider"
			],
			"aliases": {
				"QBitFlow": "QBitFlow\\Laravel\\Facades\\QBitFlow"
			}
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"php-http/discovery": true
		}
	},
	"scripts": {
		"test": "phpunit --testsuite Unit",
		"test:integration": "phpunit --testsuite Integration",
		"test:coverage": "phpunit --testsuite Unit --coverage-text",
		"analyse": "phpstan analyse --memory-limit=1G",
		"lint": "find src tests examples config -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
		"check": [
			"@composer validate --strict",
			"@lint",
			"@analyse",
			"@test"
		]
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
